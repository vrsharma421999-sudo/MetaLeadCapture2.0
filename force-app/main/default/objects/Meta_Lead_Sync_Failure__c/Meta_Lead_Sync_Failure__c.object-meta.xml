    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Dead-letter store for Meta leads that could not be turned into a Lead record — a failed Graph API callout, an unknown/inactive Page, or a Lead insert/update that was rejected (validation rule, duplicate rule, required field). Written by MetaLeadFetchQueueable instead of letting the raw payload disappear into a log message. MetaLeadSyncFailureNotifier alerts admins on insert; MetaLeadSyncFailureResend lets them retry once the underlying issue (bad mapping, missing Page config, org validation rule) is fixed, without needing Meta to redeliver the webhook.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>true</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Read</externalSharingModel>
    <label>Meta Lead Sync Failure</label>
    <nameField>
        <displayFormat>MLSF-{0000}</displayFormat>
        <label>Meta Lead Sync Failure Name</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Meta Lead Sync Failures</pluralLabel>
    <searchLayouts></searchLayouts>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
